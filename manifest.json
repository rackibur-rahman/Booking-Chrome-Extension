{
  "manifest_version": 3,
  "name": "BD Railway Auto Booking",
  "version": "4.0",
  "description": "Auto fill, search, coach and seat automation with native typing.",
  "permissions": ["storage", "activeTab", "scripting", "debugger"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "500": "logo.png"
    }
  },
  "icons": {
    "500": "logo.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}